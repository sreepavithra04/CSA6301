        "def ips_process(packet, rules, whitelist=None):\n",
        "    \"\"\"Like scan_packet, but decides whether to BLOCK (untrusted source) or\n",
        "    ALLOW-WITH-LOG (source is on the tuning whitelist, e.g. a known partner\n",
        "    IP that reliably triggers a benign false positive).\"\"\"\n",
        "    whitelist = whitelist or set()\n",
        "    alerts = scan_packet(packet, rules)\n",
        "    if not alerts:\n",
        "        return {\"action\": \"allow\", \"alerts\": []}\n",
        "    if packet.get(\"src_ip\") in whitelist:\n",
        "        return {\"action\": \"allow\", \"alerts\": alerts,\n",
        "                \"note\": \"source whitelisted, alert suppressed from blocking\"}\n",
        "    return {\"action\": \"block\", \"alerts\": alerts}"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "4d106fce"
      },
      "source": [
        "IDS_RULES = [\n",
        "    {\"pattern\": \"union select\", \"alert\": \"SQL Injection attempt\"},\n",
        "    # Add more rules as needed for testing\n",
        "]\n",
        "\n",
        "def scan_packet(packet, rules):\n",
        "    alerts = []\n",
        "    for rule in rules:\n",
        "        if rule[\"pattern\"] in packet.get(\"payload\", \"\"):\n",
        "            alerts.append(rule[\"alert\"])\n",
        "    return alerts"
      ],
      "execution_count": 5,
      "outputs": []
    },
