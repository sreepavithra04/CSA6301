            "Enter the business scenario: A bank wants to detect suspicious credit card transactions and prevent online fraud.\n",
            "\n",
            "Threat Intelligence Application Area:\n",
            "Banking Fraud Prevention\n"
          ]
        }
      ],
      "source": [
        "def identify_application_area(scenario):\n",
        "    scenario = scenario.lower()\n",
        "    if any(word in scenario for word in\n",
        "           [\"bank\", \"banking\", \"credit card\", \"transaction\", \"payment\", \"financial\"]):\n",
        "        return \"Banking Fraud Prevention\"\n",
        "    elif any(word in scenario for word in\n",
        "             [\"hospital\", \"healthcare\", \"medical\", \"patient\", \"clinic\", \"health data\"]):\n",
        "        return \"Healthcare Data Protection\"\n",
        "    elif any(word in scenario for word in\n",
        "             [\"e-commerce\", \"ecommerce\", \"online shopping\", \"customer\", \"retail\", \"shopping\"]):\n",
        "        return \"E-Commerce Fraud Prevention\"\n",
        "    elif any(word in scenario for word in\n",
        "             [\"government\", \"public sector\", \"government agency\"]):\n",
        "        return \"Government Cybersecurity\"\n",
        "    elif any(word in scenario for word in\n",
        "             [\"factory\", \"manufacturing\", \"industrial\", \"production\"]):\n",
        "        return \"Industrial/Manufacturing Security\"\n",
        "    else:\n",
        "        return \"General Cybersecurity / Threat Monitoring\"\n",
        "scenario = input(\"Enter the business scenario: \")\n",
        "result = identify_application_area(scenario)\n",
        "print(\"\\nThreat Intelligence Application Area:\")\n",
        "print(result)"
      ]
    }
