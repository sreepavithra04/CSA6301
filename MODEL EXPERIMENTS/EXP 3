            "Enter the draft security policy text:\n",
            "\n",
            "This policy applies to all company employees and information systems. The security team is responsible for implementing the policy. Violations may result in disciplinary action.\n",
            "\n",
            "Security Policy Assessment\n",
            "========================================\n",
            "[MISSING] Scope\n",
            "[MISSING] Roles And Responsibilities\n",
            "[PRESENT] Enforcement\n",
            "[MISSING] Review Cycle\n",
            "[MISSING] Approval Authority\n",
            "\n",
            "Summary\n",
            "----------------------------------------\n",
            "Missing governance elements:\n",
            "- Scope\n",
            "- Roles And Responsibilities\n",
            "- Review Cycle\n",
            "- Approval Authority\n"
          ]
        }
      ],
      "source": [
        "# Program 3: Security Policy Governance Checker\n",
        "\n",
        "required_elements = {\n",
        "    \"scope\": [\"scope\", \"applicability\", \"covered systems\"],\n",
        "    \"roles and responsibilities\": [\"roles\", \"responsibilities\", \"responsibility\"],\n",
        "    \"enforcement\": [\"enforcement\", \"violation\", \"disciplinary\"],\n",
        "    \"review cycle\": [\"review cycle\", \"review annually\", \"review every\", \"annual review\"],\n",
        "    \"approval authority\": [\"approval authority\", \"approved by\", \"approval\"]\n",
        "}\n",
        "\n",
        "policy = input(\n",
        "    \"Enter the draft security policy text:\\n\\n\"\n",
        ")\n",
        "\n",
        "policy_lower = policy.lower()\n",
        "\n",
        "print(\"\\nSecurity Policy Assessment\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "missing = []\n",
        "\n",
        "for element, keywords in required_elements.items():\n",
        "\n",
        "    found = any(keyword in policy_lower for keyword in keywords)\n",
        "\n",
        "    if found:\n",
        "        print(f\"[PRESENT] {element.title()}\")\n",
        "    else:\n",
        "        print(f\"[MISSING] {element.title()}\")\n",
        "        missing.append(element)\n",
        "\n",
        "print(\"\\nSummary\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "if len(missing) == 0:\n",
        "    print(\"All required governance elements are present.\")\n",
        "else:\n",
        "    print(\"Missing governance elements:\")\n",
        "    for item in missing:\n",
        "        print(\"-\", item.title())"
      ]
    }
