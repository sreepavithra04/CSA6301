      "source": [
        "# Program 9: Threat Intelligence Lifecycle Classifier\n",
        "\n",
        "def classify_stage(activity):\n",
        "\n",
        "    activity = activity.lower()\n",
        "\n",
        "    keywords = {\n",
        "\n",
        "        \"Direction\": [\n",
        "            \"requirement\",\n",
        "            \"objective\",\n",
        "            \"priority\",\n",
        "            \"question\",\n",
        "            \"intelligence requirement\"\n",
        "        ],\n",
        "\n",
        "        \"Collection\": [\n",
        "            \"collect\",\n",
        "            \"gather\",\n",
        "            \"osint\",\n",
        "            \"logs\",\n",
        "            \"sources\",\n",
        "            \"data collection\"\n",
        "        ],\n",
        "\n",
        "        \"Processing\": [\n",
        "            \"clean\",\n",
        "            \"normalize\",\n",
        "            \"filter\",\n",
        "            \"parse\",\n",
        "            \"organize\",\n",
        "            \"process\"\n",
        "        ],\n",
        "\n",
        "        \"Analysis\": [\n",
        "            \"analyze\",\n",
        "            \"correlate\",\n",
        "            \"investigate\",\n",
        "            \"identify\",\n",
        "            \"interpret\",\n",
        "            \"pattern\"\n",
        "        ],\n",
        "\n",
        "        \"Dissemination\": [\n",
        "            \"report\",\n",
        "            \"share\",\n",
        "            \"deliver\",\n",
        "            \"distribute\",\n",
        "            \"brief\",\n",
        "            \"stakeholders\"\n",
        "        ],\n",
        "\n",
        "        \"Feedback\": [\n",
        "            \"feedback\",\n",
        "            \"review\",\n",
        "            \"improve\",\n",
        "            \"response\",\n",
        "            \"evaluation\"\n",
        "        ]\n",
        "    }\n",
        "\n",
        "    scores = {}\n",
        "\n",
        "    for stage, words in keywords.items():\n",
        "        scores[stage] = sum(\n",
        "            word in activity for word in words\n",
        "        )\n",
        "\n",
        "    best_stage = max(scores, key=scores.get)\n",
        "\n",
        "    if scores[best_stage] == 0:\n",
        "        return \"Unable to classify\"\n",
        "\n",
        "    return best_stage\n",
        "\n",
        "\n",
        "activity = input(\"Enter intelligence team activity: \")\n",
        "\n",
        "stage = classify_stage(activity)\n",
        "\n",
        "print(\"\\nThreat Intelligence Lifecycle Stage:\")\n",
        "print(stage)"
      ]
    }
