        "# Program 13: Threat Intelligence Assessment\n",
        "\n",
        "def assess_threat_intelligence(data):\n",
        "\n",
        "    text = data.lower()\n",
        "\n",
        "    # Keywords indicating context\n",
        "    context_keywords = [\n",
        "        \"target\", \"campaign\", \"threat actor\",\n",
        "        \"organization\", \"sector\", \"affected\",\n",
        "        \"context\", \"attack\"\n",
        "    ]\n",
        "\n",
        "    # Keywords indicating confidence\n",
        "    confidence_keywords = [\n",
        "        \"confidence\", \"high confidence\",\n",
        "        \"medium confidence\", \"low confidence\",\n",
        "        \"verified\", \"confirmed\", \"likely\"\n",
        "    ]\n",
        "\n",
        "    # Keywords indicating actionability\n",
        "    action_keywords = [\n",
        "        \"block\", \"monitor\", \"patch\",\n",
        "        \"investigate\", \"mitigate\", \"action\",\n",
        "        \"recommend\", \"prevent\", \"response\"\n",
        "    ]\n",
        "\n",
        "    has_context = any(\n",
        "        word in text for word in context_keywords\n",
        "    )\n",
        "\n",
        "    has_confidence = any(\n",
        "        word in text for word in confidence_keywords\n",
        "    )\n",
        "\n",
        "    has_actionability = any(\n",
        "        word in text for word in action_keywords\n",
        "    )\n",
        "\n",
        "    print(\"\\nThreat Intelligence Assessment\")\n",
        "    print(\"=\" * 50)\n",
        "\n",
        "    print(\"Context:\", \"Present\" if has_context else \"Missing\")\n",
        "    print(\"Confidence:\", \"Present\" if has_confidence else \"Missing\")\n",
        "    print(\"Actionability:\",\n",
        "          \"Present\" if has_actionability else \"Missing\")\n",
        "\n",
        "    # Final classification\n",
        "    if has_context and has_confidence and has_actionability:\n",
        "\n",
        "        print(\"\\nClassification:\")\n",
        "        print(\"GENUINE THREAT INTELLIGENCE\")\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\"\\nClassification:\")\n",
        "        print(\"RAW / UNPROCESSED DATA\")\n",
        "\n",
        "\n",
        "# Input\n",
        "data = input(\n",
        "    \"Enter the collected security information:\\n\"\n",
        ")\n",
        "\n",
        "assess_threat_intelligence(data)"
      ],
