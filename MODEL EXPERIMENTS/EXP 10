        "# Program 10: Stateful Firewall Simulation\n",
        "\n",
        "class StatefulFirewall:\n",
        "\n",
        "    def __init__(self):\n",
        "        self.connections = set()\n",
        "\n",
        "    def outbound_packet(self, source, destination, port):\n",
        "\n",
        "        connection = (source, destination, port)\n",
        "\n",
        "        self.connections.add(connection)\n",
        "\n",
        "        print(\n",
        "            f\"OUTBOUND ALLOWED: \"\n",
        "            f\"{source} -> {destination}:{port}\"\n",
        "        )\n",
        "\n",
        "    def inbound_packet(self, source, destination, port):\n",
        "\n",
        "        # Check whether this is return traffic\n",
        "        reverse_connection = (\n",
        "            destination,\n",
        "            source,\n",
        "            port\n",
        "        )\n",
        "\n",
        "        if reverse_connection in self.connections:\n",
        "\n",
        "            print(\n",
        "                f\"RETURN TRAFFIC ALLOWED: \"\n",
        "                f\"{source} -> {destination}:{port}\"\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            print(\n",
        "                f\"INBOUND BLOCKED: \"\n",
        "                f\"{source} -> {destination}:{port}\"\n",
        "            )\n",
        "\n",
        "\n",
        "# Create firewall\n",
        "firewall = StatefulFirewall()\n",
        "\n",
        "\n",
        "print(\"Stateful Firewall Simulation\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "\n",
        "# Outbound connection\n",
        "firewall.outbound_packet(\n",
        "    \"10.0.0.5\",\n",
        "    \"93.184.216.34\",\n",
        "    443\n",
        ")\n",
        "\n",
        "\n",
        "# Return traffic\n",
        "firewall.inbound_packet(\n",
        "    \"93.184.216.34\",\n",
        "    \"10.0.0.5\",\n",
        "    443\n",
        ")\n",
        "\n",
        "\n",
        "# Unsolicited inbound traffic\n",
        "firewall.inbound_packet(\n",
        "    \"203.0.113.50\",\n",
        "    \"10.0.0.5\",\n",
        "    22\n",
        ")"
      ]
