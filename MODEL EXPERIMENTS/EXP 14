        "# Program 14: SIEM Architecture Pipeline Simulation\n",
        "\n",
        "from datetime import datetime\n",
        "\n",
        "# -----------------------------------------\n",
        "# STEP 1: Collect Raw Events\n",
        "# -----------------------------------------\n",
        "\n",
        "raw_events = [\n",
        "\n",
        "    {\n",
        "        \"source\": \"Firewall\",\n",
        "        \"ip\": \"192.168.1.50\",\n",
        "        \"event\": \"FAILED_LOGIN\"\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"source\": \"Web Server\",\n",
        "        \"ip\": \"192.168.1.50\",\n",
        "        \"event\": \"SUSPICIOUS_REQUEST\"\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"source\": \"Endpoint\",\n",
        "        \"ip\": \"192.168.1.50\",\n",
        "        \"event\": \"MALWARE_DETECTED\"\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"source\": \"Firewall\",\n",
        "        \"ip\": \"192.168.1.60\",\n",
        "        \"event\": \"NORMAL_TRAFFIC\"\n",
        "    }\n",
        "]\n",
        "\n",
        "\n",
        "print(\"STEP 1 - RAW EVENTS\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "for event in raw_events:\n",
        "    print(event)\n",
        "\n",
        "\n",
        "# -----------------------------------------\n",
        "# STEP 2: Normalize Events\n",
        "# -----------------------------------------\n",
        "\n",
        "normalized_events = []\n",
        "\n",
        "for event in raw_events:\n",
        "\n",
        "    normalized = {\n",
        "        \"timestamp\": datetime.now().strftime(\n",
        "            \"%Y-%m-%d %H:%M:%S\"\n",
        "        ),\n",
        "        \"source\": event[\"source\"],\n",
        "        \"source_ip\": event[\"ip\"],\n",
        "        \"event_type\": event[\"event\"]\n",
        "    }\n",
        "\n",
        "    normalized_events.append(normalized)\n",
        "\n",
        "\n",
        "print(\"\\nSTEP 2 - NORMALIZED EVENTS\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "for event in normalized_events:\n",
        "    print(event)\n",
        "\n",
        "\n",
        "# -----------------------------------------\n",
        "# STEP 3: Correlation\n",
        "# -----------------------------------------\n",
        "\n",
        "correlation = {}\n",
        "\n",
        "for event in normalized_events:\n",
        "\n",
        "    ip = event[\"source_ip\"]\n",
        "\n",
        "    if ip not in correlation:\n",
        "        correlation[ip] = []\n",
        "\n",
        "    correlation[ip].append(\n",
        "        event[\"event_type\"]\n",
        "    )\n",
        "\n",
        "\n",
        "print(\"\\nSTEP 3 - CORRELATION\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "for ip, events in correlation.items():\n",
        "\n",
        "    print(\"IP:\", ip)\n",
        "    print(\"Events:\", events)\n",
        "\n",
        "\n",
        "# -----------------------------------------\n",
        "# STEP 4: Generate Alerts\n",
        "# -----------------------------------------\n",
        "\n",
        "print(\"\\nSTEP 4 - SIEM ALERTS\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "for ip, events in correlation.items():\n",
        "\n",
        "    suspicious_events = [\n",
        "        \"FAILED_LOGIN\",\n",
        "        \"SUSPICIOUS_REQUEST\",\n",
        "        \"MALWARE_DETECTED\"\n",
        "    ]\n",
        "\n",
        "    count = sum(\n",
        "        event in suspicious_events\n",
        "        for event in events\n",
        "    )\n",
        "\n",
        "    if count >= 2:\n",
        "\n",
        "        print(\n",
        "            \"ALERT: Suspicious activity detected!\"\n",
        "        )\n",
        "\n",
        "        print(\"Source IP:\", ip)\n",
        "        print(\"Events:\", events)\n",
        "        print(\"Severity: HIGH\")\n",
        "\n",
        "    elif count == 1:\n",
        "\n",
        "        print(\n",
        "            \"WARNING: Suspicious event detected.\"\n",
        "        )\n",
        "\n",
        "        print(\"Source IP:\", ip)\n",
        "        print(\"Events:\", events)\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\n",
        "            \"INFO: Normal activity from\",\n",
        "            ip\n",
        "        )"
