        "# Program 7: ELK Stack Simulation\n",
        "\n",
        "import re\n",
        "from collections import Counter\n",
        "\n",
        "# --------------------------------\n",
        "# STEP 1: Raw Log Data\n",
        "# --------------------------------\n",
        "\n",
        "raw_logs = [\n",
        "    \"2026-08-25 10:15:22 INFO 192.168.1.10 LOGIN_SUCCESS user=alice\",\n",
        "    \"2026-08-25 10:16:10 WARN 192.168.1.20 LOGIN_FAILED user=bob\",\n",
        "    \"2026-08-25 10:17:05 ERROR 192.168.1.30 MALWARE_DETECTED user=admin\",\n",
        "    \"2026-08-25 10:18:12 INFO 192.168.1.10 LOGIN_SUCCESS user=alice\",\n",
        "    \"2026-08-25 10:19:30 WARN 192.168.1.20 LOGIN_FAILED user=bob\"\n",
        "]\n",
        "\n",
        "\n",
        "# --------------------------------\n",
        "# STEP 2: Logstash-style Parsing\n",
        "# --------------------------------\n",
        "\n",
        "def parse_log(log):\n",
        "\n",
        "    pattern = (\n",
        "        r\"(\\S+)\\s+(\\S+)\\s+\"\n",
        "        r\"(INFO|WARN|ERROR)\\s+\"\n",
        "        r\"(\\S+)\\s+(\\S+)\\s+user=(\\S+)\"\n",
        "    )\n",
        "\n",
        "    match = re.match(pattern, log)\n",
        "\n",
        "    if match:\n",
        "        date, time, level, ip, event, user = match.groups()\n",
        "\n",
        "        return {\n",
        "            \"date\": date,\n",
        "            \"time\": time,\n",
        "            \"level\": level,\n",
        "            \"ip\": ip,\n",
        "            \"event\": event,\n",
        "            \"user\": user\n",
        "        }\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "structured_events = []\n",
        "\n",
        "for log in raw_logs:\n",
        "    event = parse_log(log)\n",
        "\n",
        "    if event:\n",
        "        structured_events.append(event)\n",
        "\n",
        "\n",
        "print(\"LOGSTASH - Parsed Events\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "for event in structured_events:\n",
        "    print(event)\n",
        "\n",
        "\n",
        "# --------------------------------\n",
        "# STEP 3: Elasticsearch-style Index\n",
        "# --------------------------------\n",
        "\n",
        "elasticsearch_index = []\n",
        "\n",
        "for event in structured_events:\n",
        "    elasticsearch_index.append(event)\n",
        "\n",
        "\n",
        "print(\"\\nELASTICSEARCH - Indexed Events\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "print(\"Total indexed documents:\",\n",
        "      len(elasticsearch_index))\n",
        "\n",
        "\n",
        "# --------------------------------\n",
        "# STEP 4: Kibana-style Aggregation\n",
        "# --------------------------------\n",
        "\n",
        "level_counts = Counter(\n",
        "    event[\"level\"]\n",
        "    for event in elasticsearch_index\n",
        ")\n",
        "\n",
        "event_counts = Counter(\n",
        "    event[\"event\"]\n",
        "    for event in elasticsearch_index\n",
        ")\n",
        "\n",
        "ip_counts = Counter(\n",
        "    event[\"ip\"]\n",
        "    for event in elasticsearch_index\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\nKIBANA - Log Level Aggregation\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "for level, count in level_counts.items():\n",
        "    print(level, \":\", count)\n",
        "\n",
        "\n",
        "print(\"\\nKIBANA - Event Aggregation\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "for event, count in event_counts.items():\n",
        "    print(event, \":\", count)\n",
        "\n",
        "\n",
        "print(\"\\nKIBANA - Source IP Aggregation\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "for ip, count in ip_counts.items():\n",
        "    print(ip, \":\", count)"
