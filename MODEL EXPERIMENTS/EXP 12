      "source": [
        "# Program 12: SOC Alert Priority Classifier\n",
        "\n",
        "def classify_alert(alert):\n",
        "\n",
        "    alert = alert.lower()\n",
        "\n",
        "    # P1 - Critical\n",
        "    p1_keywords = [\n",
        "        \"ransomware\",\n",
        "        \"data breach\",\n",
        "        \"active attack\",\n",
        "        \"critical server compromised\",\n",
        "        \"mass compromise\",\n",
        "        \"production down\",\n",
        "        \"exfiltration\"\n",
        "    ]\n",
        "\n",
        "    # P2 - High\n",
        "    p2_keywords = [\n",
        "        \"malware\",\n",
        "        \"privilege escalation\",\n",
        "        \"multiple failed logins\",\n",
        "        \"suspicious administrator\",\n",
        "        \"credential theft\",\n",
        "        \"command and control\",\n",
        "        \"c2\"\n",
        "    ]\n",
        "\n",
        "    # P3 - Medium\n",
        "    p3_keywords = [\n",
        "        \"phishing attempt\",\n",
        "        \"suspicious login\",\n",
        "        \"port scan\",\n",
        "        \"unusual traffic\",\n",
        "        \"malicious email\",\n",
        "        \"failed login\"\n",
        "    ]\n",
        "\n",
        "    # P1\n",
        "    if any(word in alert for word in p1_keywords):\n",
        "        return \"P1 - Critical\"\n",
        "\n",
        "    # P2\n",
        "    elif any(word in alert for word in p2_keywords):\n",
        "        return \"P2 - High\"\n",
        "\n",
        "    # P3\n",
        "    elif any(word in alert for word in p3_keywords):\n",
        "        return \"P3 - Medium\"\n",
        "\n",
        "    # P4\n",
        "    else:\n",
        "        return \"P4 - Low\"\n",
        "\n",
        "\n",
        "alert = input(\"Enter SOC alert description: \")\n",
        "\n",
        "priority = classify_alert(alert)\n",
        "\n",
        "print(\"\\nSOC Alert Triage\")\n",
        "print(\"=\" * 40)\n",
        "print(\"Alert:\", alert)\n",
        "print(\"Priority:\", priority)"
      ]
    }
