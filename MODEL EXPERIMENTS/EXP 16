        "# Program 16: Defense-in-Depth Simulation\n",
        "\n",
        "# -----------------------------------------\n",
        "# Security Layers\n",
        "# -----------------------------------------\n",
        "\n",
        "security_layers = [\n",
        "    \"Firewall\",\n",
        "    \"Network IDS\",\n",
        "    \"Endpoint Protection\",\n",
        "    \"Authentication\",\n",
        "    \"Application Security\"\n",
        "]\n",
        "\n",
        "\n",
        "# -----------------------------------------\n",
        "# Simulated Attack\n",
        "# -----------------------------------------\n",
        "\n",
        "attack = {\n",
        "    \"Firewall\": False,\n",
        "    \"Network IDS\": True,\n",
        "    \"Endpoint Protection\": True,\n",
        "    \"Authentication\": True,\n",
        "    \"Application Security\": True\n",
        "}\n",
        "\n",
        "\n",
        "print(\"DEFENSE-IN-DEPTH SIMULATION\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "attack_blocked = False\n",
        "\n",
        "for layer in security_layers:\n",
        "\n",
        "    print(\"\\nSecurity Layer:\", layer)\n",
        "\n",
        "    if attack[layer]:\n",
        "\n",
        "        print(\"Result: ATTACK BLOCKED\")\n",
        "        attack_blocked = True\n",
        "\n",
        "        print(\"\\nFinal Result:\")\n",
        "        print(\"Attack stopped at\", layer)\n",
        "\n",
        "        break\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\"Result: Attack passed through\")\n",
        "\n",
        "\n",
        "# -----------------------------------------\n",
        "# Final Result\n",
        "# -----------------------------------------\n",
        "\n",
        "if not attack_blocked:\n",
        "\n",
        "    print(\"\\nFinal Result:\")\n",
        "    print(\"WARNING: Attack passed through all layers.\")\n",
        "\n",
        "else:\n",
        "\n",
        "    print(\"\\nDefense-in-Depth successfully protected the system.\")"
      ]
    }
  ]
