        "# Program 11: Packet Sniffing using Scapy\n",
        "\n",
        "from scapy.all import sniff, IP, TCP, UDP, ICMP\n",
        "\n",
        "\n",
        "def packet_summary(packet):\n",
        "\n",
        "    if IP in packet:\n",
        "\n",
        "        source = packet[IP].src\n",
        "        destination = packet[IP].dst\n",
        "\n",
        "        if TCP in packet:\n",
        "            protocol = \"TCP\"\n",
        "\n",
        "        elif UDP in packet:\n",
        "            protocol = \"UDP\"\n",
        "\n",
        "        elif ICMP in packet:\n",
        "            protocol = \"ICMP\"\n",
        "\n",
        "        else:\n",
        "            protocol = \"Other\"\n",
        "\n",
        "        print(\n",
        "            f\"Protocol: {protocol:<6} \"\n",
        "            f\"Source: {source:<15} \"\n",
        "            f\"Destination: {destination}\"\n",
        "        )\n",
        "\n",
        "\n",
        "print(\"Starting packet capture...\")\n",
        "print(\"Capturing 10 packets...\\n\")\n",
        "\n",
        "packets = sniff(\n",
        "    count=10,\n",
        "    prn=packet_summary\n",
        ")\n",
        "\n",
        "print(\"\\nPacket capture completed.\")"
