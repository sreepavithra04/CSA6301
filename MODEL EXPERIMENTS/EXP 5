      "source": [
        "# Program 5: Threat Intelligence Report Classifier\n",
        "\n",
        "def classify_report(description, audience):\n",
        "\n",
        "    text = (description + \" \" + audience).lower()\n",
        "\n",
        "    strategic_keywords = [\n",
        "        \"executive\",\n",
        "        \"management\",\n",
        "        \"leadership\",\n",
        "        \"board\",\n",
        "        \"long-term\",\n",
        "        \"business risk\",\n",
        "        \"investment\",\n",
        "        \"policy\",\n",
        "        \"organization\"\n",
        "    ]\n",
        "\n",
        "    tactical_keywords = [\n",
        "        \"security team\",\n",
        "        \"soc\",\n",
        "        \"defender\",\n",
        "        \"attack techniques\",\n",
        "        \"tactics\",\n",
        "        \"techniques\",\n",
        "        \"procedures\",\n",
        "        \"mitigation\",\n",
        "        \"threat actor\"\n",
        "    ]\n",
        "\n",
        "    operational_keywords = [\n",
        "        \"analyst\",\n",
        "        \"incident response\",\n",
        "        \"alert\",\n",
        "        \"ip address\",\n",
        "        \"domain\",\n",
        "        \"hash\",\n",
        "        \"malware sample\",\n",
        "        \"indicator\",\n",
        "        \"ioc\",\n",
        "        \"real-time\"\n",
        "    ]\n",
        "\n",
        "    strategic_score = sum(word in text for word in strategic_keywords)\n",
        "    tactical_score = sum(word in text for word in tactical_keywords)\n",
        "    operational_score = sum(word in text for word in operational_keywords)\n",
        "\n",
        "    scores = {\n",
        "        \"Strategic\": strategic_score,\n",
        "        \"Tactical\": tactical_score,\n",
        "        \"Operational\": operational_score\n",
        "    }\n",
        "\n",
        "    classification = max(scores, key=scores.get)\n",
        "\n",
        "    if all(score == 0 for score in scores.values()):\n",
        "        classification = \"Unable to classify\"\n",
        "\n",
        "    return classification, scores\n",
        "\n",
        "\n",
        "# User input\n",
        "description = input(\"Enter threat intelligence report description: \")\n",
        "audience = input(\"Enter intended audience: \")\n",
        "\n",
        "classification, scores = classify_report(description, audience)\n",
        "\n",
        "print(\"\\nClassification Result\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "print(\"Strategic Score :\", scores[\"Strategic\"])\n",
        "print(\"Tactical Score  :\", scores[\"Tactical\"])\n",
        "print(\"Operational Score:\", scores[\"Operational\"])\n",
        "\n",
        "print(\"\\nFinal Classification:\", classification)"
