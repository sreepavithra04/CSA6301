        "# Program 4: VPN Confidentiality Demonstration\n",
        "# Simple XOR stream cipher used only as an educational example\n",
        "\n",
        "def xor_encrypt(data, key):\n",
        "    encrypted = \"\"\n",
        "\n",
        "    for i, char in enumerate(data):\n",
        "        encrypted += chr(\n",
        "            ord(char) ^ ord(key[i % len(key)])\n",
        "        )\n",
        "\n",
        "    return encrypted\n",
        "\n",
        "\n",
        "def xor_decrypt(data, key):\n",
        "    return xor_encrypt(data, key)\n",
        "\n",
        "\n",
        "# Original message\n",
        "message = input(\"Enter message to send through VPN: \")\n",
        "\n",
        "# Shared secret key\n",
        "key = input(\"Enter shared secret key: \")\n",
        "\n",
        "# Encrypt the message\n",
        "encrypted_data = xor_encrypt(message, key)\n",
        "\n",
        "print(\"\\nOriginal Data:\")\n",
        "print(message)\n",
        "\n",
        "print(\"\\nCaptured Data in Transit:\")\n",
        "print(repr(encrypted_data))\n",
        "\n",
        "# Try to decrypt with wrong key\n",
        "wrong_key = input(\"\\nEnter an incorrect key to demonstrate confidentiality: \")\n",
        "\n",
        "wrong_decrypted = xor_decrypt(encrypted_data, wrong_key)\n",
        "\n",
        "print(\"\\nDecryption using incorrect key:\")\n",
        "print(wrong_decrypted)\n",
        "\n",
        "# Correct decryption\n",
        "decrypted_data = xor_decrypt(encrypted_data, key)\n",
        "\n",
        "print(\"\\nDecryption using correct shared key:\")\n",
        "print(decrypted_data)\n",
        "\n",
        "if decrypted_data == message:\n",
        "    print(\"\\nResult: Confidentiality successfully demonstrated.\")"
      ]
