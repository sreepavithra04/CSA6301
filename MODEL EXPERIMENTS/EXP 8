        "# Program 8: Network Segmentation Simulation\n",
        "\n",
        "# Network segments\n",
        "LOW_TRUST = \"Low-Trust\"\n",
        "INTERNAL = \"Internal\"\n",
        "SENSITIVE = \"Sensitive\"\n",
        "\n",
        "\n",
        "# Access policy\n",
        "allowed_connections = {\n",
        "    LOW_TRUST: [INTERNAL],\n",
        "    INTERNAL: [SENSITIVE],\n",
        "    SENSITIVE: []\n",
        "}\n",
        "\n",
        "\n",
        "def check_access(source, destination):\n",
        "\n",
        "    if destination in allowed_connections.get(source, []):\n",
        "        return \"ALLOWED\"\n",
        "    else:\n",
        "        return \"BLOCKED\"\n",
        "\n",
        "\n",
        "print(\"Network Segmentation Access Policy\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "print(\"Low-Trust -> Internal:\",\n",
        "      check_access(LOW_TRUST, INTERNAL))\n",
        "\n",
        "print(\"Low-Trust -> Sensitive:\",\n",
        "      check_access(LOW_TRUST, SENSITIVE))\n",
        "\n",
        "print(\"Internal -> Sensitive:\",\n",
        "      check_access(INTERNAL, SENSITIVE))\n",
        "\n",
        "\n",
        "# Simulate compromised low-trust system\n",
        "print(\"\\nLateral Movement Simulation\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "source = LOW_TRUST\n",
        "target = SENSITIVE\n",
        "\n",
        "result = check_access(source, target)\n",
        "\n",
        "print(\"Compromised Segment:\", source)\n",
        "print(\"Target Segment:\", target)\n",
        "print(\"Access Result:\", result)\n",
        "\n",
        "if result == \"BLOCKED\":\n",
        "    print(\"Lateral movement successfully prevented.\")\n",
        "else:\n",
        "    print(\"Warning: Lateral movement is possible.\")"
      ]
    }
